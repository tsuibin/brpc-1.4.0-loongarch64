+
+"	st.d	$a2, $a0, 152\n"
+
+"	pcaddi	$a1, 3\n"
+"	st.d	$a1, $a0, 144\n"
+"	jirl $zero, $ra, 0\n"
+
+"finish:\n"
+" or	$a0, $zero, $zero\n"
+" bl _exit\n"
+);
+
+#endif
